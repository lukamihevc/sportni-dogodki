<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="10.1.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SportniDogodki.csproj" />
  </ItemGroup>

    <PropertyGroup>
  <CollectCoverage>true</CollectCoverage>
  <Include>[SportniDogodki]*</Include>
  <Exclude>[SportniDogodki]SportniDogodki.Pages.*,[SportniDogodki]Pages_*</Exclude>
  <ExcludeByFile>**/Program.cs,**/Pages/*.cs,**/Pages/**/*.cs,**/*.cshtml</ExcludeByFile>
  <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
  <Threshold>100</Threshold>
  <ThresholdType>line</ThresholdType>
</PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.*" />
  </ItemGroup>

</Project>
